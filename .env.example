# Public build setting. Leave core for the CRM and Finance release.
NEXT_PUBLIC_ERP_MODULE_PROFILE=core

# Server only values. Set these in Vercel project environment settings.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
S3_BUCKET=
S3_REGION=us-east-1
# Optional for a non AWS S3 compatible service.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ERP_OWNER_EMAIL=
# Optional AI providers.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_DAILY_LIMIT=10
