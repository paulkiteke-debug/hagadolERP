    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "db:prepare-identities": "node scripts/prepare-identities.mjs",
    "test:runtime": "node --import tsx tests/node-runtime-qa.ts",
    "test:bundle": "node tests/bundle-qa.mjs",
    "test:crm-import": "node scripts/run-qa.mjs full --loader ./tests/tsx-loader.mjs tests/crm-import-qa.mjs",
    "test:crm-activity-import": "node scripts/run-qa.mjs full --loader ./tests/tsx-loader.mjs tests/crm-activity-import-qa.mjs",
