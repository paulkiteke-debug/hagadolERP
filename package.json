    "test:ai": "node scripts/run-qa.mjs full tests/ai-release-qa.mjs",
    "test:eos": "node scripts/run-qa.mjs full --loader ./tests/tsx-loader.mjs tests/eos-l10-qa.mjs",
    "test:governance": "node scripts/run-qa.mjs full --loader ./tests/tsx-loader.mjs tests/governance-qa.mjs",
    "test:eos-dynamic": "node scripts/run-qa.mjs full --loader ./tests/tsx-loader.mjs tests/eos-dynamic-qa.mjs",
    "test:crm": "node scripts/run-qa.mjs full --loader ./tests/tsx-loader.mjs tests/crm-qa.mjs",
    "test:finance": "node scripts/run-qa.mjs full --loader ./tests/tsx-loader.mjs tests/finance-qa.mjs",
    "test:finance-planning": "node scripts/run-qa.mjs full --loader ./tests/tsx-loader.mjs tests/finance-planning-qa.mjs",
