    "lint:ci": "node scripts/lint-ci.mjs",
    "test:migrations": "node tests/migrations-qa.mjs",
    "test:crm-workflow": "node --import tsx tests/crm-workflow-qa.ts",
    "test:finance-posting": "node scripts/run-qa.mjs full --import tsx tests/finance-posting-workflow-qa.ts",
    "test:crm-pipeline": "node scripts/run-qa.mjs full --loader ./tests/tsx-loader.mjs tests/crm-pipeline-qa.mjs",
    "test:crm-handover": "node scripts/run-qa.mjs full --loader ./tests/tsx-loader.mjs tests/crm-handover-qa.mjs",
    "test:crm-preview": "node scripts/run-qa.mjs full --loader ./tests/tsx-loader.mjs tests/crm-import-preview-qa.mjs",
    "test:crm-rbac": "node scripts/run-qa.mjs full tests/crm-rbac-qa.mjs",
    "test:crm-permissions-ui": "node scripts/run-qa.mjs full --loader ./tests/tsx-loader.mjs tests/crm-permission-ui-qa.mjs",
