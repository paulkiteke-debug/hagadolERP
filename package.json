    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.2.1",
    "tsx": "4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "@babel/core": "7.29.6",
    "browserslist": "4.28.7",
    "baseline-browser-mapping": "2.11.0",
    "fast-uri": "3.1.8",
    "source-map-js": "1.2.2",
    "sharp": "0.35.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.0",
    "undici": "7.29.1",
    "js-yaml": "4.3.2",
    "fflate": "0.7.5",
    "image-size": "2.0.3"
  }
}
