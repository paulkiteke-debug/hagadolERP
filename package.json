{
  "name": "hagadol-erp",
  "version": "1.3.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "next dev",
    "build": "next build --webpack",
